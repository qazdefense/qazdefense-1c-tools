<#
    Шаблон настроек деплоя конфигурации 1С в тестовую ИБ.

    Скопируйте этот файл в config.psd1 (в этой же папке) и заполните
    реальными значениями. config.psd1 добавлен в .gitignore и не
    коммитится — там может быть логин/пароль.
#>
@{
    # Какая база 1С в репозитории (см. <ИмяБазы>/Configuration/ на верхнем
    # уровне, например "Болванка" или "Бухгалтерия для Казахстана") —
    # деплой-скрипты работают именно с ней. Пусто/отсутствует = "Болванка".
    ConfigBase = "Болванка"

    # File — файловая ИБ (путь к папке, где лежит 1Cv8.1CD).
    # Server — серверная ИБ (кластер 1С).
    ConnectionType = "File"

    File = @{
        # Путь к папке файловой информационной базы.
        Path = "D:\BASES\test\Болванка"
    }

    Server = @{
        # Адрес сервера/кластера 1С, например server1c или server1c:1541.
        Server = ""
        # Имя информационной базы на сервере (как в списке баз кластера).
        Ref = ""
    }

    # Путь к 1cv8.exe нужной версии платформы.
    PlatformPath = "C:\Program Files (x86)\1cv8\8.3.27.1989\bin\1cv8.exe"

    Auth = @{
        # Логин пользователя 1С. Пусто, если авторизация в базе не требуется.
        User = ""
        # Пароль пользователя 1С. Пусто, если авторизация не требуется.
        Password = ""
    }

    # URL веб-публикации этой базы (веб-клиент), если она опубликована —
    # например "http://localhost/mybase/". Эти скрипты сами его не читают;
    # поле здесь для инструментов, которые тестируют веб-клиент (например,
    # github.com/qazdefense/1c-gui-test-kit). Пусто — публикации нет.
    WebUrl = ""
}
