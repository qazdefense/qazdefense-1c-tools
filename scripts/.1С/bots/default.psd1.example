<#
    Шаблон Telegram-уведомления о деплое (см. common.ps1, Send-TelegramNotification).
    Полностью опционально: скопируйте в default.psd1 (или в <Имя>.psd1 и
    передавайте -AgentId <Имя>) и заполните — иначе уведомления просто не
    отправляются, ничего не ломается. Реальный файл с токеном в .gitignore
    добавлять обязательно — не коммитьте его.
#>
@{
    # Токен бота из @BotFather.
    BotToken = ""
    # Chat id, куда слать (пользователь, группа или супергруппа).
    ChatId = ""
    # Опционально: id темы форума внутри супергруппы. Пусто — в общий чат.
    MessageThreadId = ""
    # "Always" | "OnSuccess" | "OnFailure". Пусто = "Always".
    NotifyOn = "Always"
}
