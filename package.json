{
  "name": "1c-tools",
  "displayName": "1С QazDefense Tools",
  "description": "Базы 1С этой машины с запуском Предприятия/Конфигуратора без проекта, мастер настройки, профили баз и задачи деплоя, дерево метаданных как в Конфигураторе (заимствованные объекты, фильтр по подсистемам), ER-диаграммы связей, визуализация форм, просмотр макетов, предопределённые элементы и заимствование объектов в расширение — из боковой панели",
  "version": "0.18.2",
  "publisher": "qazdefense",
  "author": "QazDefense",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/QazDefense/qazdefense-1c-tools.git"
  },
  "bugs": {
    "url": "https://github.com/QazDefense/qazdefense-1c-tools/issues"
  },
  "keywords": [
    "1C",
    "1С",
    "1С:Предприятие",
    "1C:Enterprise",
    "BSL",
    "Конфигуратор"
  ],
  "icon": "icon-brand.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oneCLauncher",
          "title": "1С: базы",
          "icon": "icon-brand.png"
        },
        {
          "id": "oneCLauncherProject",
          "title": "1С: проект",
          "icon": "icon-project.svg"
        }
      ]
    },
    "views": {
      "oneCLauncher": [
        {
          "id": "oneCLauncherSystemBases",
          "name": "Базы 1С"
        },
        {
          "id": "oneCLauncherBases",
          "name": "Базы проекта"
        },
        {
          "id": "oneCLauncherBaseTasks",
          "name": "Задачи"
        }
      ],
      "oneCLauncherProject": [
        {
          "id": "oneCLauncherView",
          "name": "Задачи"
        },
        {
          "id": "oneCLauncherMetadata",
          "name": "Метаданные"
        }
      ]
    },
    "commands": [
      {
        "command": "oneCLauncher.switchBase",
        "title": "1С: Сменить базу"
      },
      {
        "command": "oneCLauncher.editBaseProfile",
        "title": "1С: Настройки базы",
        "icon": "$(gear)"
      },
      {
        "command": "oneCLauncher.addBaseProfile",
        "title": "1С: Добавить базу",
        "icon": "$(add)"
      },
      {
        "command": "oneCLauncher.refreshBases",
        "title": "1С: Обновить список баз",
        "icon": "$(refresh)"
      },
      {
        "command": "oneCLauncher.refreshMetadata",
        "title": "1С: Обновить метаданные",
        "icon": "$(refresh)"
      },
      {
        "command": "oneCLauncher.showErDiagram",
        "title": "1С: ER-диаграмма объекта",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "oneCLauncher.visualizeForm",
        "title": "1С: Визуализация формы",
        "icon": "$(layout)"
      },
      {
        "command": "oneCLauncher.showPredefined",
        "title": "1С: Предопределённые элементы",
        "icon": "$(list-tree)"
      },
      {
        "command": "oneCLauncher.previewTemplate",
        "title": "1С: Просмотр макета",
        "icon": "$(table)"
      },
      {
        "command": "oneCLauncher.toggleSubsystemFilter",
        "title": "1С: Фильтр по подсистеме (вкл/выкл)",
        "icon": "$(filter)"
      },
      {
        "command": "oneCLauncher.clearSubsystemFilter",
        "title": "1С: Снять фильтр по подсистеме",
        "icon": "$(filter-filled)"
      },
      {
        "command": "oneCLauncher.borrowObject",
        "title": "1С: Заимствовать в расширение",
        "icon": "$(link)"
      },
      {
        "command": "oneCLauncher.copyObjectPath",
        "title": "1С: Копировать путь объекта"
      },
      {
        "command": "oneCLauncher.openSetup",
        "title": "1С: Настройка расширения",
        "icon": "$(gear)"
      },
      {
        "command": "oneCLauncher.refreshSystemBases",
        "title": "1С: Обновить список баз 1С",
        "icon": "$(refresh)"
      },
      {
        "command": "oneCLauncher.openBasePanel",
        "title": "1С: Панель базы",
        "icon": "$(window)"
      },
      {
        "command": "oneCLauncher.startEnterprise",
        "title": "1С: Запустить Предприятие (база из списка)",
        "icon": "$(play)"
      },
      {
        "command": "oneCLauncher.startDesigner",
        "title": "1С: Открыть Конфигуратор (база из списка)",
        "icon": "$(tools)"
      },
      {
        "command": "oneCLauncher.createProfileFromBase",
        "title": "1С: Завести профилем проекта",
        "icon": "$(new-file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "oneCLauncher.refreshSystemBases",
          "when": "view == oneCLauncherSystemBases",
          "group": "navigation@1"
        },
        {
          "command": "oneCLauncher.addBaseProfile",
          "when": "view == oneCLauncherBases",
          "group": "navigation"
        },
        {
          "command": "oneCLauncher.refreshBases",
          "when": "view == oneCLauncherBases",
          "group": "navigation"
        },
        {
          "command": "oneCLauncher.clearSubsystemFilter",
          "when": "view == oneCLauncherMetadata && oneCLauncherSubsystemFilterActive",
          "group": "navigation"
        },
        {
          "command": "oneCLauncher.refreshMetadata",
          "when": "view == oneCLauncherMetadata",
          "group": "navigation"
        },
        {
          "command": "oneCLauncher.openSetup",
          "when": "view == oneCLauncherSystemBases",
          "group": "navigation@9"
        },
        {
          "command": "oneCLauncher.openSetup",
          "when": "view == oneCLauncherBases",
          "group": "navigation@9"
        },
        {
          "command": "oneCLauncher.openSetup",
          "when": "view == oneCLauncherBaseTasks",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "oneCLauncher.startEnterprise",
          "when": "view == oneCLauncherSystemBases && viewItem == system-base",
          "group": "inline@1"
        },
        {
          "command": "oneCLauncher.startDesigner",
          "when": "view == oneCLauncherSystemBases && viewItem == system-base",
          "group": "inline@2"
        },
        {
          "command": "oneCLauncher.openBasePanel",
          "when": "view == oneCLauncherSystemBases && viewItem == system-base",
          "group": "1c@1"
        },
        {
          "command": "oneCLauncher.createProfileFromBase",
          "when": "view == oneCLauncherSystemBases && viewItem == system-base",
          "group": "1c@2"
        },
        {
          "command": "oneCLauncher.editBaseProfile",
          "when": "view == oneCLauncherBases && viewItem == base-profile",
          "group": "inline"
        },
        {
          "command": "oneCLauncher.showErDiagram",
          "when": "view == oneCLauncherMetadata && viewItem =~ /^metadata-object/",
          "group": "1c@1"
        },
        {
          "command": "oneCLauncher.visualizeForm",
          "when": "view == oneCLauncherMetadata && viewItem =~ /^metadata-object/",
          "group": "1c@2"
        },
        {
          "command": "oneCLauncher.visualizeForm",
          "when": "view == oneCLauncherMetadata && viewItem == metadata-form-file",
          "group": "1c@1"
        },
        {
          "command": "oneCLauncher.visualizeForm",
          "when": "view == oneCLauncherMetadata && viewItem == metadata-form-file",
          "group": "inline"
        },
        {
          "command": "oneCLauncher.visualizeForm",
          "when": "view == oneCLauncherMetadata && viewItem == metadata-formdir",
          "group": "1c@1"
        },
        {
          "command": "oneCLauncher.visualizeForm",
          "when": "view == oneCLauncherMetadata && viewItem == metadata-formdir",
          "group": "inline"
        },
        {
          "command": "oneCLauncher.previewTemplate",
          "when": "view == oneCLauncherMetadata && viewItem =~ /^metadata-object/",
          "group": "1c@3"
        },
        {
          "command": "oneCLauncher.previewTemplate",
          "when": "view == oneCLauncherMetadata && viewItem == metadata-template-file",
          "group": "1c@1"
        },
        {
          "command": "oneCLauncher.previewTemplate",
          "when": "view == oneCLauncherMetadata && viewItem == metadata-template-file",
          "group": "inline"
        },
        {
          "command": "oneCLauncher.previewTemplate",
          "when": "view == oneCLauncherMetadata && viewItem == metadata-templatedir",
          "group": "1c@1"
        },
        {
          "command": "oneCLauncher.previewTemplate",
          "when": "view == oneCLauncherMetadata && viewItem == metadata-templatedir",
          "group": "inline"
        },
        {
          "command": "oneCLauncher.showPredefined",
          "when": "view == oneCLauncherMetadata && viewItem =~ /-predefinable$/",
          "group": "1c@4"
        },
        {
          "command": "oneCLauncher.toggleSubsystemFilter",
          "when": "view == oneCLauncherMetadata && viewItem =~ /-subsystem$/",
          "group": "1c@5"
        },
        {
          "command": "oneCLauncher.borrowObject",
          "when": "view == oneCLauncherMetadata && viewItem =~ /^metadata-object-own-root/",
          "group": "1c@6"
        },
        {
          "command": "oneCLauncher.copyObjectPath",
          "when": "view == oneCLauncherMetadata && viewItem =~ /^metadata-object/",
          "group": "1c@7"
        }
      ]
    },
    "configuration": {
      "title": "1С QazDefense Tools",
      "properties": {
        "qazdefense1c.platformPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Путь к `1cv8.exe`. Пусто — платформа ищется сама в `Program Files\\1cv8\\<версия>\\bin` (берётся самая новая, подходящая по версии базы)."
        },
        "qazdefense1c.basesListFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Дополнительные файлы списка баз (`*.v8i`). Пользовательский и общий `ibases.v8i` читаются всегда."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "qazdefense1cStart",
        "title": "1С QazDefense Tools: первые шаги",
        "description": "Платформа, список баз, запуск и — при желании — проект с деплоем и метаданными.",
        "steps": [
          {
            "id": "setup",
            "title": "Проверить настройку",
            "description": "Мастер покажет, что уже найдено (платформа, базы), а чего не хватает.\n[Открыть настройку](command:oneCLauncher.openSetup)",
            "media": {
              "markdown": "resources/walkthrough/setup.md"
            }
          },
          {
            "id": "bases",
            "title": "Запустить базу",
            "description": "Вкладка «1С: базы» — ваш обычный список баз 1С. Клик по базе открывает панель запуска.\n[Обновить список баз](command:oneCLauncher.refreshSystemBases)",
            "media": {
              "markdown": "resources/walkthrough/bases.md"
            }
          },
          {
            "id": "project",
            "title": "Подключить проект (необязательно)",
            "description": "Профиль базы в проекте открывает задачи деплоя и дерево метаданных.\n[Добавить базу проекта](command:oneCLauncher.addBaseProfile)",
            "media": {
              "markdown": "resources/walkthrough/project.md"
            }
          },
          {
            "id": "metadata",
            "title": "Посмотреть метаданные",
            "description": "Дерево как в Конфигураторе: ER-диаграммы, визуализация форм, макеты, заимствование в расширение.\n[Обновить метаданные](command:oneCLauncher.refreshMetadata)",
            "media": {
              "markdown": "resources/walkthrough/metadata.md"
            }
          }
        ]
      }
    ]
  }
}
